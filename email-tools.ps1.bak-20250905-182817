function Get-MimeById {
  [CmdletBinding()]
  param([Parameter(Mandatory=$true)][string]$Id)

  try {
    chcp 65001 | Out-Null
    $utf8 = [System.Text.UTF8Encoding]::new($false)
    [Console]::OutputEncoding = $utf8
    $OutputEncoding = $utf8
  } catch {}

  $resp = Invoke-RestMethod -Uri "http://localhost:8088/gmail/get" `
    -Method Post -ContentType "application/json" `
    -Body (@{ id = $Id } | ConvertTo-Json)

  if ($resp -is [string]) { return $resp }
  elseif ($resp.mime) { return [string]$resp.mime }
  elseif ($resp.raw)  { return [string]$resp.raw }
  elseif ($resp.data) { return [string]$resp.data }
  else { return ($resp | ConvertTo-Json -Depth 6) }
}

function Get-HeaderValue {
  [CmdletBinding()]
  param(
    [Parameter(Mandatory=$true)][string]$Headers,
    [Parameter(Mandatory=$true)][string]$Name
  )
  # Desplegar continuations (CRLF + WSP)
  $unfold = $Headers -replace "(\r?\n)[ \t]+", ' '
  $pattern = '(?mi)^\s*' + [regex]::Escape($Name) + '\s*:\s*(.*)$'
  $m = [regex]::Match($unfold, $pattern)
  if ($m.Success) { return ($m.Groups[1].Value.Trim()) }
  return $null
}
